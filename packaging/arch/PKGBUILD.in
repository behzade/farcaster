pkgname=farcaster
pkgver=@VERSION@
pkgrel=1
pkgdesc='Native desktop client for coding agents'
arch=('x86_64')
url='https://github.com/behzade/farcaster'
license=('GPL-3.0-or-later')
depends=('gcc-libs' 'glibc' 'fontconfig' 'freetype2' 'libx11' 'libxcb'
         'libxkbcommon' 'libxkbcommon-x11' 'wayland' 'libglvnd'
         'vulkan-icd-loader' 'libxml2' 'libc++>=22' 'git' 'ca-certificates')
optdepends=('neovim: embedded editor' 'espeak-ng: spoken voice replies')
makedepends=('rust>=1.98' 'clang' 'cmake' 'pkgconf')
# Ghostty needs this compiler even when Arch upgrades Zig.
_zigver=0.17.0
source=("$url/releases/download/v$pkgver/farcaster-$pkgver-source.tar.gz"
        "https://ziglang.org/download/$_zigver/zig-x86_64-linux-$_zigver.tar.xz")
sha256sums=('@SHA256@'
            '1cbe9df9f27e6b78d14ccbca43b6703a404ef79ef1c463de901d7f088d4e2026')
options=('!lto' '!debug')

build() {
    cd "$srcdir/farcaster-$pkgver"
    export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$srcdir/target}"
    export ZIG="$srcdir/zig-x86_64-linux-$_zigver/zig"
    cargo build --release --locked --bin farcaster
}

package() {
    cd "$srcdir/farcaster-$pkgver"
    sh scripts/install-linux.sh "${CARGO_TARGET_DIR:-$srcdir/target}/release/farcaster" "$pkgdir/usr"
}
