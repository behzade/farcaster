diff --git a/test/unit/subagent-wait.test.ts b/test/unit/subagent-wait.test.ts
index e42a778..e7ade70 100644
--- a/test/unit/subagent-wait.test.ts
+++ b/test/unit/subagent-wait.test.ts
@@ -6 +6 @@ import { describe, it } from "node:test";
-import { WAIT_TOOL_ENABLED_ENV, resolveWaitToolConfig, waitForSubagents, type SubagentWaitDeps } from "../../src/runs/background/subagent-wait.ts";
+import { SUBAGENT_WAIT_STEER_EVENT, WAIT_TOOL_ENABLED_ENV, resolveWaitToolConfig, waitForSubagents, type SubagentWaitDeps } from "../../src/runs/background/subagent-wait.ts";
@@ -430,0 +431,41 @@ describe("subagent_wait tool", () => {
+	it("yields immediately to a steering message while background work keeps running", async () => {
+		const root = fs.mkdtempSync(path.join(os.tmpdir(), "pi-wait-steer-"));
+		try {
+			const asyncRoot = path.join(root, "runs");
+			const state = makeState("sess-1");
+			writeStatus(asyncRoot, "run-a", "running", { sessionId: "sess-1", pid: 999999 });
+			const handlers = new Map<string, Array<(data: unknown) => void>>();
+			const events = {
+				on(channel: string, handler: (data: unknown) => void) {
+					const list = handlers.get(channel) ?? [];
+					list.push(handler);
+					handlers.set(channel, list);
+					return () => handlers.set(channel, (handlers.get(channel) ?? []).filter((candidate) => candidate !== handler));
+				},
+				emit(channel: string, data: unknown) {
+					for (const handler of handlers.get(channel) ?? []) handler(data);
+				},
+			};
+			const startedAt = Date.now();
+			const waiting = waitForSubagents({ all: true, timeoutMs: 30_000 }, undefined, baseDeps(root, state, {
+				events,
+				pollIntervalMs: 10_000,
+			}));
+
+			setTimeout(() => events.emit(SUBAGENT_WAIT_STEER_EVENT, undefined), 15);
+
+			const result = await waiting;
+			assert.equal(result.isError, undefined);
+			assert.match(textOf(result), /steering message arrived/i);
+			assert.match(textOf(result), /run-a \(running\)/);
+			assert.ok(Date.now() - startedAt < 5_000, "steering should yield before the poll interval");
+			assert.equal(
+				JSON.parse(fs.readFileSync(path.join(asyncRoot, "run-a", "status.json"), "utf-8")).state,
+				"running",
+				"yielding the wait must not stop the child",
+			);
+		} finally {
+			fs.rmSync(root, { recursive: true, force: true });
+		}
+	});
+
