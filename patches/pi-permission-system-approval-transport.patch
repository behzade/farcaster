index 00000000..1d5b7697
--- /dev/null
+++ b/packages/pi-permission-system/src/user-approval.ts
@@ -0,0 +1,553 @@
+import { existsSync, readdirSync, readFileSync } from "node:fs";
+import { join } from "node:path";
+import type { ForwarderContext } from "#src/authority/forwarder-context";
+import {
+  ensureDirectoryExists,
+  formatUnknownErrorMessage,
+  safeDeleteFile,
+  sleep,
+  tryRemoveDirectoryIfEmpty,
+  writeJsonFileAtomic,
+} from "#src/authority/forwarding-io";
+import {
+  PERMISSION_FORWARDING_POLL_INTERVAL_MS,
+  PERMISSION_FORWARDING_SERVING_GRACE_MS,
+  PERMISSION_FORWARDING_TIMEOUT_MS,
+  resolvePermissionForwardingTarget,
+} from "#src/authority/permission-forwarding";
+import type { ServingLookup } from "#src/authority/serving-registry";
+import type { SubagentDetector } from "#src/authority/subagent-detection";
+import type { SubagentSessionRegistry } from "#src/authority/subagent-registry";
+import {
+  emitUiPromptEvent,
+  type PermissionEventBus,
+} from "#src/permission-events";
+import type {
+  UserApprovalChoice,
+  UserApprovalRequest,
+  UserApprovalResult,
+} from "#src/service";
+import type { DebugReviewLogger } from "#src/session-logger";
+
+const USER_APPROVAL_PROTOCOL_VERSION = 1;
+const MAX_REQUEST_TEXT_LENGTH = 32 * 1024;
+const MAX_CHOICE_COUNT = 8;
+const MAX_CHOICE_TEXT_LENGTH = 512;
+
+interface UserApprovalLocation {
+  rootDir: string;
+  requestsDir: string;
+  responsesDir: string;
+}
+
+interface ForwardedUserApprovalRequest {
+  protocolVersion: 1;
+  id: string;
+  callerRequestId: string;
+  createdAt: number;
+  requesterSessionId: string;
+  targetSessionId: string;
+  requesterAgentName: string | null;
+  title: string;
+  message: string;
+  source: UserApprovalRequest["source"];
+  surface: string | null;
+  value: string | null;
+  choices: UserApprovalChoice[];
+  reasonTitle?: string;
+  reasonPlaceholder?: string;
+}
+
+interface ForwardedUserApprovalResponse extends UserApprovalResult {
+  protocolVersion: 1;
+  responderSessionId: string;
+  respondedAt: number;
+}
+
+interface UserApprovalBrokerDeps {
+  forwardingDir: string;
+  getContext: () => ForwarderContext | null;
+  detection: SubagentDetector;
+  registry?: SubagentSessionRegistry;
+  serving?: ServingLookup;
+  events: PermissionEventBus;
+  logger: DebugReviewLogger;
+}
+
+/**
+ * User-facing approval transport shared by extensions through
+ * `PermissionsService.requestUserApproval`.
+ *
+ * The caller owns policy and the meaning of each choice. This broker validates
+ * and renders the request, forwarding it to the parent UI for a headless child.
+ */
+export class UserApprovalBroker {
+  constructor(private readonly deps: UserApprovalBrokerDeps) {}
+
+  async request(request: UserApprovalRequest): Promise<UserApprovalResult> {
+    const normalized = normalizeUserApprovalRequest(request);
+    const ctx = this.deps.getContext();
+    if (!ctx) {
+      return unavailable("Permission session is not active");
+    }
+    if (ctx.hasUI) {
+      return this.prompt(ctx, normalized, request.signal, null);
+    }
+    if (!this.deps.detection.isSubagent(ctx)) {
+      return unavailable("No user approval UI is available");
+    }
+    return this.forward(ctx, normalized, request.signal);
+  }
+
+  async processInbox(ctx: ForwarderContext): Promise<void> {
+    const sessionId = ctx.sessionManager.getSessionId();
+    if (!sessionId) return;
+    const location = approvalLocation(this.deps.forwardingDir, sessionId);
+    if (!existsSync(location.requestsDir)) return;
+
+    for (const fileName of listJsonFiles(location.requestsDir)) {
+      const requestPath = join(location.requestsDir, fileName);
+      const request = readForwardedRequest(requestPath);
+      if (!request || request.targetSessionId !== sessionId) {
+        safeDeleteFile(
+          this.deps.logger,
+          requestPath,
+          "forwarded user approval request",
+        );
+        continue;
+      }
+      await this.serve(ctx, location, requestPath, request);
+    }
+    cleanupLocation(this.deps.logger, location);
+  }
+
+  private async forward(
+    ctx: ForwarderContext,
+    request: UserApprovalRequest,
+    signal?: AbortSignal,
+  ): Promise<UserApprovalResult> {
+    const requesterSessionId = ctx.sessionManager.getSessionId();
+    const target = resolvePermissionForwardingTarget({
+      hasUI: false,
+      isSubagent: true,
+      currentSessionId: requesterSessionId,
+      env: process.env,
+      sessionId: requesterSessionId,
+      registry: this.deps.registry,
+    });
+    if (!requesterSessionId || !target) {
+      return unavailable("Parent permission session could not be resolved");
+    }
+    const targetSessionId = target.sessionId;
+
+    const location = ensureApprovalLocation(
+      this.deps.logger,
+      this.deps.forwardingDir,
+      targetSessionId,
+    );
+    if (!location)
+      return unavailable("Parent approval transport is unavailable");
+
+    const id = `${Date.now()}-${Math.random().toString(36).slice(2, 10)}-${process.pid}`;
+    const forwarded: ForwardedUserApprovalRequest = {
+      protocolVersion: USER_APPROVAL_PROTOCOL_VERSION,
+      id,
+      callerRequestId: request.requestId,
+      createdAt: Date.now(),
+      requesterSessionId,
+      targetSessionId,
+      requesterAgentName: request.agentName ?? null,
+      title: request.title,
+      message: request.message,
+      source: request.source,
+      surface: request.surface,
+      value: request.value,
+      choices: request.choices.map((choice) => ({ ...choice })),
+      ...(request.reasonTitle ? { reasonTitle: request.reasonTitle } : {}),
+      ...(request.reasonPlaceholder
+        ? { reasonPlaceholder: request.reasonPlaceholder }
+        : {}),
+    };
+    const requestPath = join(location.requestsDir, `${id}.json`);
+    const responsePath = join(location.responsesDir, `${id}.json`);
+    try {
+      writeJsonFileAtomic(this.deps.logger, requestPath, forwarded);
+    } catch (error) {
+      return unavailable(formatUnknownErrorMessage(error));
+    }
+
+    const deadline = Date.now() + PERMISSION_FORWARDING_TIMEOUT_MS;
+    let unservedSince: number | null = null;
+    while (Date.now() < deadline) {
+      if (signal?.aborted) {
+        safeDeleteFile(
+          this.deps.logger,
+          requestPath,
+          "cancelled user approval request",
+        );
+        cleanupLocation(this.deps.logger, location);
+        return { choiceId: null, aborted: true };
+      }
+      if (existsSync(responsePath)) {
+        const response = readForwardedResponse(responsePath, request.choices);
+        safeDeleteFile(
+          this.deps.logger,
+          responsePath,
+          "user approval response",
+        );
+        safeDeleteFile(this.deps.logger, requestPath, "user approval request");
+        cleanupLocation(this.deps.logger, location);
+        return (
+          response ??
+          unavailable("Parent returned an invalid approval response")
+        );
+      }
+      if (
+        target.source === "registry" &&
+        this.deps.serving &&
+        !this.deps.serving.isServing(targetSessionId)
+      ) {
+        unservedSince ??= Date.now();
+        if (
+          Date.now() - unservedSince >=
+          PERMISSION_FORWARDING_SERVING_GRACE_MS
+        ) {
+          this.deps.logger.review("user_approval.no_serving_session", {
+            requesterSessionId,
+            targetSessionId,
+            servingSessionIds: this.deps.serving.servingIds(),
+          });
+          safeDeleteFile(
+            this.deps.logger,
+            requestPath,
+            "unserved user approval request",
+          );
+          cleanupLocation(this.deps.logger, location);
+          return unavailable(
+            `Session '${targetSessionId}' is not serving approval requests`,
+          );
+        }
+      } else {
+        unservedSince = null;
+      }
+      await sleep(PERMISSION_FORWARDING_POLL_INTERVAL_MS);
+    }
+
+    safeDeleteFile(
+      this.deps.logger,
+      requestPath,
+      "timed-out user approval request",
+    );
+    cleanupLocation(this.deps.logger, location);
+    return unavailable("Timed out waiting for parent approval");
+  }
+
+  private async serve(
+    ctx: ForwarderContext,
+    location: UserApprovalLocation,
+    requestPath: string,
+    request: ForwardedUserApprovalRequest,
+  ): Promise<void> {
+    const controller = new AbortController();
+    const timer = setInterval(() => {
+      if (!existsSync(requestPath)) controller.abort();
+    }, PERMISSION_FORWARDING_POLL_INTERVAL_MS);
+    let result: UserApprovalResult;
+    try {
+      result = await this.prompt(
+        ctx,
+        { ...request, requestId: request.callerRequestId },
+        controller.signal,
+        {
+          requesterAgentName: request.requesterAgentName,
+          requesterSessionId: request.requesterSessionId,
+        },
+      );
+    } catch (error) {
+      result = unavailable(formatUnknownErrorMessage(error));
+    } finally {
+      clearInterval(timer);
+    }
+
+    if (!existsSync(requestPath)) return;
+    const responsePath = join(location.responsesDir, `${request.id}.json`);
+    try {
+      writeJsonFileAtomic(this.deps.logger, responsePath, {
+        protocolVersion: USER_APPROVAL_PROTOCOL_VERSION,
+        ...result,
+        responderSessionId: ctx.sessionManager.getSessionId() ?? "unknown",
+        respondedAt: Date.now(),
+      } satisfies ForwardedUserApprovalResponse);
+      safeDeleteFile(
+        this.deps.logger,
+        requestPath,
+        "served user approval request",
+      );
+    } catch (error) {
+      this.deps.logger.review("user_approval.response_failed", {
+        requestId: request.callerRequestId,
+        error: formatUnknownErrorMessage(error),
+      });
+    }
+  }
+
+  private async prompt(
+    ctx: ForwarderContext,
+    request: UserApprovalRequest,
+    signal: AbortSignal | undefined,
+    forwarding: {
+      requesterAgentName: string | null;
+      requesterSessionId: string | null;
+    } | null,
+  ): Promise<UserApprovalResult> {
+    emitUiPromptEvent(this.deps.events, {
+      requestId: request.requestId,
+      source: request.source,
+      surface: request.surface,
+      value: request.value,
+      agentName: request.agentName ?? null,
+      message: request.message,
+      forwarding,
+    });
+    const selected = await ctx.ui.select(
+      `${request.title}\n${request.message}`,
+      request.choices.map((choice) => choice.label),
+      { signal },
+    );
+    const choice = request.choices.find(
+      (candidate) => candidate.label === selected,
+    );
+    if (!choice) {
+      return { choiceId: null, ...(signal?.aborted ? { aborted: true } : {}) };
+    }
+    const reason = choice.requestReason
+      ? await ctx.ui.input(
+          request.reasonTitle ?? "Tell the agent what to do instead",
+          request.reasonPlaceholder ?? "Short note",
+          { signal },
+        )
+      : undefined;
+    return { choiceId: choice.id, ...(reason ? { reason } : {}) };
+  }
+}
+
+function normalizeUserApprovalRequest(
+  request: UserApprovalRequest,
+): UserApprovalRequest {
+  if (!boundedText(request.requestId, MAX_CHOICE_TEXT_LENGTH)) {
+    throw new Error(
+      "User approval requestId must be a non-empty bounded string",
+    );
+  }
+  if (!boundedText(request.title, MAX_CHOICE_TEXT_LENGTH)) {
+    throw new Error("User approval title must be a non-empty bounded string");
+  }
+  if (!boundedText(request.message, MAX_REQUEST_TEXT_LENGTH)) {
+    throw new Error("User approval message must be a non-empty bounded string");
+  }
+  if (
+    !["tool_call", "skill_input", "skill_read"].includes(request.source) ||
+    !(
+      request.surface === null ||
+      boundedText(request.surface, MAX_CHOICE_TEXT_LENGTH)
+    ) ||
+    !(
+      request.value === null ||
+      boundedText(request.value, MAX_REQUEST_TEXT_LENGTH)
+    ) ||
+    !(
+      request.agentName === undefined ||
+      boundedText(request.agentName, MAX_CHOICE_TEXT_LENGTH)
+    ) ||
+    !(
+      request.reasonTitle === undefined ||
+      boundedText(request.reasonTitle, MAX_CHOICE_TEXT_LENGTH)
+    ) ||
+    !(
+      request.reasonPlaceholder === undefined ||
+      boundedText(request.reasonPlaceholder, MAX_CHOICE_TEXT_LENGTH)
+    )
+  ) {
+    throw new Error("User approval metadata is invalid or too long");
+  }
+  if (request.choices.length < 2 || request.choices.length > MAX_CHOICE_COUNT) {
+    throw new Error(`User approval requires 2-${MAX_CHOICE_COUNT} choices`);
+  }
+  const ids = new Set<string>();
+  const labels = new Set<string>();
+  for (const choice of request.choices) {
+    if (
+      !boundedText(choice.id, MAX_CHOICE_TEXT_LENGTH) ||
+      !boundedText(choice.label, MAX_CHOICE_TEXT_LENGTH) ||
+      ids.has(choice.id) ||
+      labels.has(choice.label)
+    ) {
+      throw new Error(
+        "User approval choices require unique bounded ids and labels",
+      );
+    }
+    ids.add(choice.id);
+    labels.add(choice.label);
+  }
+  return {
+    ...request,
+    choices: request.choices.map((choice) => ({ ...choice })),
+  };
+}
+
+function boundedText(value: unknown, maxLength: number): value is string {
+  return (
+    typeof value === "string" && value.length > 0 && value.length <= maxLength
+  );
+}
+
+function unavailable(reason: string): UserApprovalResult {
+  return { choiceId: null, unavailableReason: reason };
+}
+
+function approvalLocation(
+  forwardingDir: string,
+  sessionId: string,
+): UserApprovalLocation {
+  const rootDir = join(
+    forwardingDir,
+    "user-approvals",
+    "sessions",
+    encodeURIComponent(sessionId),
+  );
+  return {
+    rootDir,
+    requestsDir: join(rootDir, "requests"),
+    responsesDir: join(rootDir, "responses"),
+  };
+}
+
+function ensureApprovalLocation(
+  logger: DebugReviewLogger,
+  forwardingDir: string,
+  sessionId: string,
+): UserApprovalLocation | null {
+  const location = approvalLocation(forwardingDir, sessionId);
+  return ensureDirectoryExists(
+    logger,
+    location.rootDir,
+    "user approval root",
+  ) &&
+    ensureDirectoryExists(
+      logger,
+      location.requestsDir,
+      "user approval requests",
+    ) &&
+    ensureDirectoryExists(
+      logger,
+      location.responsesDir,
+      "user approval responses",
+    )
+    ? location
+    : null;
+}
+
+function cleanupLocation(
+  logger: DebugReviewLogger,
+  location: UserApprovalLocation,
+): void {
+  const requestsGone = tryRemoveDirectoryIfEmpty(
+    logger,
+    location.requestsDir,
+    "user approval requests",
+  );
+  if (requestsGone) {
+    tryRemoveDirectoryIfEmpty(
+      logger,
+      location.responsesDir,
+      "user approval responses",
+    );
+  }
+  tryRemoveDirectoryIfEmpty(logger, location.rootDir, "user approval root");
+}
+
+function listJsonFiles(directory: string): string[] {
+  try {
+    return readdirSync(directory)
+      .filter((name) => name.endsWith(".json"))
+      .sort();
+  } catch {
+    return [];
+  }
+}
+
+function readForwardedRequest(
+  path: string,
+): ForwardedUserApprovalRequest | null {
+  try {
+    const parsed = JSON.parse(
+      readFileSync(path, "utf8"),
+    ) as ForwardedUserApprovalRequest;
+    if (
+      parsed.protocolVersion !== USER_APPROVAL_PROTOCOL_VERSION ||
+      !boundedText(parsed.id, MAX_CHOICE_TEXT_LENGTH) ||
+      !boundedText(parsed.callerRequestId, MAX_CHOICE_TEXT_LENGTH) ||
+      typeof parsed.createdAt !== "number" ||
+      !boundedText(parsed.requesterSessionId, MAX_CHOICE_TEXT_LENGTH) ||
+      !boundedText(parsed.targetSessionId, MAX_CHOICE_TEXT_LENGTH)
+    ) {
+      return null;
+    }
+    const normalized = normalizeUserApprovalRequest({
+      requestId: parsed.callerRequestId,
+      title: parsed.title,
+      message: parsed.message,
+      source: parsed.source,
+      surface: parsed.surface,
+      value: parsed.value,
+      agentName: parsed.requesterAgentName ?? undefined,
+      choices: parsed.choices,
+      reasonTitle: parsed.reasonTitle,
+      reasonPlaceholder: parsed.reasonPlaceholder,
+    });
+    return {
+      ...parsed,
+      title: normalized.title,
+      message: normalized.message,
+      source: normalized.source,
+      surface: normalized.surface,
+      value: normalized.value,
+      choices: normalized.choices.map((choice) => ({ ...choice })),
+    };
+  } catch {
+    return null;
+  }
+}
+
+function readForwardedResponse(
+  path: string,
+  choices: readonly UserApprovalChoice[],
+): UserApprovalResult | null {
+  try {
+    const parsed = JSON.parse(
+      readFileSync(path, "utf8"),
+    ) as ForwardedUserApprovalResponse;
+    if (
+      parsed.protocolVersion !== USER_APPROVAL_PROTOCOL_VERSION ||
+      typeof parsed.responderSessionId !== "string" ||
+      typeof parsed.respondedAt !== "number" ||
+      !(
+        parsed.choiceId === null ||
+        (typeof parsed.choiceId === "string" &&
+          choices.some((choice) => choice.id === parsed.choiceId))
+      )
+    ) {
+      return null;
+    }
+    return {
+      choiceId: parsed.choiceId,
+      ...(typeof parsed.reason === "string" ? { reason: parsed.reason } : {}),
+      ...(parsed.aborted === true ? { aborted: true } : {}),
+      ...(typeof parsed.unavailableReason === "string"
+        ? { unavailableReason: parsed.unavailableReason }
+        : {}),
+    };
+  } catch {
+    return null;
+  }
+}
