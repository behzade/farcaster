diff --git a/packages/pi-permission-system/test/user-approval.test.ts b/packages/pi-permission-system/test/user-approval.test.ts
new file mode 100644
index 00000000..0cbd5e9e
--- /dev/null
+++ b/packages/pi-permission-system/test/user-approval.test.ts
@@ -0,0 +1,170 @@
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import {
+  createEventBus,
+  type ExtensionContext,
+} from "@earendil-works/pi-coding-agent";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { UserApprovalBroker } from "#src/user-approval";
+
+const roots: string[] = [];
+
+afterEach(() => {
+  vi.useRealTimers();
+  vi.unstubAllEnvs();
+  for (const root of roots.splice(0)) {
+    rmSync(root, { recursive: true, force: true });
+  }
+});
+
+function makeCtx(options: {
+  sessionId: string;
+  hasUI: boolean;
+  select?: (title: string, choices: string[]) => Promise<string | undefined>;
+}): ExtensionContext {
+  return {
+    cwd: "/test/project",
+    hasUI: options.hasUI,
+    mode: options.hasUI ? "tui" : "print",
+    sessionManager: {
+      getSessionId: () => options.sessionId,
+    },
+    ui: {
+      select: options.select ?? (async () => undefined),
+      input: async () => undefined,
+    },
+  } as unknown as ExtensionContext;
+}
+
+function makeBroker(options: {
+  forwardingDir: string;
+  ctx: ExtensionContext;
+  isSubagent: boolean;
+  registry?: {
+    get(sessionId: string): { parentSessionId: string } | undefined;
+  };
+  serving?: {
+    isServing(sessionId: string): boolean;
+    servingIds(): readonly string[];
+  };
+}) {
+  return new UserApprovalBroker({
+    forwardingDir: options.forwardingDir,
+    getContext: () => options.ctx,
+    detection: { isSubagent: () => options.isSubagent },
+    registry: options.registry as never,
+    serving: options.serving,
+    events: createEventBus(),
+    logger: { review: vi.fn(), debug: vi.fn() },
+  });
+}
+
+const request = {
+  requestId: "sandbox-1",
+  title: "Sandbox permission",
+  message: "Allow read access to /tmp/input?",
+  source: "tool_call" as const,
+  surface: "read",
+  value: "/tmp/input",
+  choices: [
+    { id: "allow", label: "Allow" },
+    { id: "deny", label: "No" },
+  ],
+};
+
+describe("local approval", () => {
+  it("returns the caller-owned choice id", async () => {
+    const root = mkdtempSync(join(tmpdir(), "pi-user-approval-"));
+    roots.push(root);
+    const ctx = makeCtx({
+      sessionId: "parent",
+      hasUI: true,
+      select: async () => "Allow",
+    });
+    const broker = makeBroker({ forwardingDir: root, ctx, isSubagent: false });
+
+    await expect(broker.request(request)).resolves.toEqual({
+      choiceId: "allow",
+    });
+  });
+
+  it("rejects duplicate choice labels", async () => {
+    const root = mkdtempSync(join(tmpdir(), "pi-user-approval-"));
+    roots.push(root);
+    const ctx = makeCtx({ sessionId: "parent", hasUI: true });
+    const broker = makeBroker({ forwardingDir: root, ctx, isSubagent: false });
+
+    await expect(
+      broker.request({
+        ...request,
+        choices: [
+          { id: "first", label: "Same" },
+          { id: "second", label: "Same" },
+        ],
+      }),
+    ).rejects.toThrow("unique bounded ids and labels");
+  });
+});
+
+describe("forwarded approval", () => {
+  it("abandons an in-process request when no parent session serves it", async () => {
+    vi.useFakeTimers();
+    const root = mkdtempSync(join(tmpdir(), "pi-user-approval-"));
+    roots.push(root);
+    const childCtx = makeCtx({ sessionId: "child", hasUI: false });
+    const broker = makeBroker({
+      forwardingDir: root,
+      ctx: childCtx,
+      isSubagent: true,
+      registry: { get: () => ({ parentSessionId: "parent" }) },
+      serving: { isServing: () => false, servingIds: () => [] },
+    });
+
+    const pending = broker.request(request);
+    await vi.advanceTimersByTimeAsync(2_250);
+    await expect(pending).resolves.toEqual({
+      choiceId: null,
+      unavailableReason: "Session 'parent' is not serving approval requests",
+    });
+  });
+
+  it("routes a headless child request to the parent UI", async () => {
+    const root = mkdtempSync(join(tmpdir(), "pi-user-approval-"));
+    roots.push(root);
+    vi.stubEnv("PI_SUBAGENT_PARENT_SESSION", "parent");
+    const childCtx = makeCtx({ sessionId: "child", hasUI: false });
+    const parentCtx = makeCtx({
+      sessionId: "parent",
+      hasUI: true,
+      select: async () => "Allow",
+    });
+    const child = makeBroker({
+      forwardingDir: root,
+      ctx: childCtx,
+      isSubagent: true,
+    });
+    const parent = makeBroker({
+      forwardingDir: root,
+      ctx: parentCtx,
+      isSubagent: false,
+    });
+
+    const pending = child.request(request);
+    const deadline = Date.now() + 2000;
+    while (Date.now() < deadline) {
+      await parent.processInbox(parentCtx);
+      const settled = await Promise.race([
+        pending.then((result) => ({ settled: true as const, result })),
+        new Promise<{ settled: false }>((resolve) =>
+          setTimeout(() => resolve({ settled: false }), 10),
+        ),
+      ]);
+      if (settled.settled) {
+        expect(settled.result).toEqual({ choiceId: "allow" });
+        return;
+      }
+    }
+    throw new Error("Timed out waiting for forwarded user approval");
+  });
+});
