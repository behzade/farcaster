+const ACTIVE_TOOL_GUIDANCE_MARKER = "<!-- pi:active-tool-guidance -->";
+/** Collect active tool snippets and de-duplicated cross-call guidance. */
+function collectToolGuidance(selectedTools, toolSnippets, promptGuidelines) {
